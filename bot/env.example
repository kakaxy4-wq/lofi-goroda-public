# Скопировать в /opt/lofi-goroda/bot.env на сервере и заполнить. В репозиторий значения не класть.
BOT_TOKEN=
OWNER_ID=
CHANNEL_ID=
# общий секрет бота и server/live.py (заголовок X-Bot-Key); длинная случайная строка
BOT_KEY=
# необязательные (значения по умолчанию в скобках)
# POST_TIME=21:00
# TZ_NAME=Europe/Moscow
# SITE_URL=http://lofigoroda-web  (не «web»: в общей сети traefik это имя занято другими проектами)
# LIVE_URL=http://lofigoroda-live:8766
# Чтение стены ВКонтакте блогера (посты → «ставим точку?»). Без ключа VK выключен.
# Как получить: vk.com/apps?act=manage → создать Standalone-приложение → Настройки → «Сервисный ключ доступа».
# VK_SERVICE_KEY=
# VK_DOMAIN=gruzin_na_marse
